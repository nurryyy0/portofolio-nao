# Supabase (copy file ini ke `.env` lalu isi dengan nilai dari Dashboard Supabase:
# Project Settings -> API -> Project URL dan API keys)
# URL = base domain (tanpa /rest/v1/ di belakang)
VITE_SUPABASE_URL=
# Key publishable (format baru, diawali sb_publishable_...). Isi salah satu:
# pakai yang ini ATAU VITE_SUPABASE_ANON_KEY di bawah. Publishable key didahulukan.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Key anon/publishable legacy (JWT, diawali "eyJ...")
VITE_SUPABASE_ANON_KEY=
# Email admin (wajib SAMA dengan email di policy RLS + akun Supabase Auth)
# ⚠️ GANTI dengan email admin kamu sebelum jalankan public_features.sql & rls_admin.sql di SQL Editor
# Bisa diisi beberapa email, dipisah koma: admin1@kamu.com,admin2@kamu.com
VITE_ADMIN_EMAIL=admin2@naomi.dev

# ── Secret untuk Edge Function send-contact-email ────────────
# JANGAN simpan di .env frontend ini! Secret harus ditaruh di sisi server:
#   copy `supabase/.env.example` -> `supabase/.env`, isi nilainya, lalu:
#   npm run secrets:email        (kirim secrets ke Supabase)
#   npm run deploy:email         (deploy edge function)
#   RESEND_API_KEY       = API key dari resend.com
#   CONTACT_FROM_EMAIL   = alamat pengirim (terverifikasi di Resend)
#   CONTACT_OWNER_EMAIL  = alamat email pemilik portfolio (tujuan pesan)
# Aset hasil build (nama file ber-hash) → cache permanen.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Gambar & font di root public/ → cache 1 hari (file jarang berubah).
/*.png
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.jpeg
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/*.ico
  Cache-Control: public, max-age=86400
